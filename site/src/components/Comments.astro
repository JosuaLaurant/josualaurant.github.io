---
const themeBase = new URL('/giscus/', Astro.site ?? Astro.url.origin).href;
---

<section class="comments" aria-labelledby="comments-title">
	<h2 id="comments-title">댓글</h2>
	<p class="comments-note">GitHub 계정으로 남길 수 있습니다. 댓글은 이 블로그 저장소의 Discussions에 저장됩니다.</p>
	<div class="giscus" data-theme-base={themeBase}></div>
</section>

<script>
	const frame = document.querySelector<HTMLElement>('.giscus');
	const themeBase = frame?.dataset.themeBase ?? '';
	const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
	const currentTheme = () => {
		const theme = document.documentElement.dataset.theme ?? (darkQuery.matches ? 'dark' : 'light');
		return `${themeBase}${theme === 'dark' ? 'dark' : 'light'}.css`;
	};

	if (frame) {
		const script = document.createElement('script');
		Object.entries({
			src: 'https://giscus.app/client.js',
			'data-repo': 'JosuaLaurant/josualaurant.github.io',
			'data-repo-id': 'R_kgDOOMxcDA',
			'data-category': 'Announcements',
			'data-category-id': 'DIC_kwDOOMxcDM4DJ7eg',
			'data-mapping': 'pathname',
			'data-strict': '1',
			'data-reactions-enabled': '1',
			'data-emit-metadata': '0',
			'data-input-position': 'top',
			'data-theme': currentTheme(),
			'data-lang': 'ko',
			'data-loading': 'lazy',
			crossorigin: 'anonymous',
		}).forEach(([name, value]) => script.setAttribute(name, value));
		script.async = true;
		frame.append(script);
	}

	const syncTheme = () => {
		const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
		iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme: currentTheme() } } }, 'https://giscus.app');
	};

	new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	darkQuery.addEventListener('change', syncTheme);
</script>

<style>
	.comments {
		border-top: 1px solid var(--line);
		margin-top: clamp(3rem, 7vw, 4.5rem);
		padding-top: clamp(2rem, 5vw, 3rem);
	}

	h2 {
		font-size: clamp(1.6rem, 4vw, 2.15rem);
		letter-spacing: -0.04em;
		line-height: 1.22;
		margin: 0 0 0.6rem;
	}

	.comments-note {
		color: var(--ink-muted);
		font-size: 0.92rem;
		margin: 0 0 1.6rem;
	}

	.giscus {
		min-height: 8rem;
	}
</style>
