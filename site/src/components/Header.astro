---
const isUpdatesPage = Astro.url.pathname === '/updates/';
---

<header class="site-header">
	<div class="site-shell header-inner">
		<a class="brand" href="/" aria-label="Josua Laurant 홈">Josua Laurant</a>
		<nav aria-label="주요 메뉴">
			<a href="/#categories">주제</a>
			<a href="/categories/direct/">직접 쓴 글</a>
			<a href="/updates/" aria-current={isUpdatesPage ? 'page' : undefined}>업데이트</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		align-items: center;
		display: flex;
		height: 4.25rem;
		justify-content: space-between;
	}

	.brand {
		color: var(--ink);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.045em;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: clamp(0.55rem, 2vw, 1rem);
	}

	nav a {
		color: var(--ink-muted);
		font-size: 0.92rem;
		letter-spacing: 0.01em;
		text-decoration: none;
	}

		nav a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.22rem;
	}

	.brand:active,
	nav a:active {
		color: var(--accent-deep);
	}

	@media (max-width: 24rem) {
		.header-inner {
			gap: 0.7rem;
		}

		.brand {
			font-size: 0.98rem;
		}

		nav a {
			font-size: 0.84rem;
		}
	}
</style>
