---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../lib/categories';

interface Props {
	posts: CollectionEntry<'blog'>[];
	numbers: Map<string, number>;
}

const { posts, numbers } = Astro.props;
const formatShortDate = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<ol class="index-list ruled">
	{posts.map((post) => (
		<li>
			<span class="no mono">No.{String(numbers.get(post.id) ?? 0).padStart(3, '0')}</span>
			<a href={`/posts/${post.id}/`}>{post.data.title}</a>
			<time class="date mono" datetime={post.data.pubDate.toISOString()}>{formatShortDate(post.data.pubDate)}</time>
			<p>
				{getCategory(post.data.category).label}
				{post.data.writing === 'ai-authored' && <b> · ✦ AI 작성</b>} — {post.data.description}
			</p>
		</li>
	))}
</ol>

<style>
	.index-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		column-gap: 1rem;
		display: grid;
		grid-template-columns: 3.6rem minmax(0, 1fr) auto;
		line-height: var(--rule-gap);
		padding-bottom: var(--rule-gap);
	}

	.no {
		color: var(--pen-red);
		font-size: 0.85rem;
		font-weight: 700;
	}

	a {
		color: var(--ink);
		font-size: 1.08rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		text-decoration: none;
	}

	a:hover {
		color: var(--accent-deep);
		text-decoration: underline;
		text-underline-offset: 0.25rem;
	}

	a:active {
		color: var(--accent-deep);
	}

	.date {
		color: var(--ink-muted);
		font-size: 0.8rem;
	}

	p {
		color: var(--ink-muted);
		font-size: 0.88rem;
		grid-column: 2 / 4;
		margin: 0;
	}

	b {
		color: var(--accent-deep);
	}

	@media (max-width: 40rem) {
		li {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.date,
		p {
			grid-column: 2;
		}
	}
</style>
