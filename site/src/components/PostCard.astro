---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../lib/categories';
import { formatDate } from '../lib/posts';
import SummaryLabel from './SummaryLabel.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const category = getCategory(post.data.category);
---

<article class="post-card">
	<div class="post-meta">
		<a href={`/categories/${post.data.category}/`}>{category.label}</a>
		<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
	</div>
	<h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
	<div class="summary">
		<SummaryLabel summary={post.data.summary} />
		<p>{post.data.description}</p>
	</div>
	<ul aria-label="태그">
		{post.data.tags.map((tag) => (
			<li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
		))}
	</ul>
</article>

<style>
	.post-card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		padding: clamp(1.25rem, 3vw, 1.8rem);
		transition: border-color var(--motion-interactive) var(--motion-ease), transform var(--motion-interactive) var(--motion-ease);
	}

	.post-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.post-meta {
		display: flex;
		font-size: 0.8rem;
		gap: 0.4rem;
		letter-spacing: 0.01em;
	}

	.post-meta a,
	.post-meta time {
		color: var(--ink-muted);
	}

	.post-meta a {
		font-weight: 700;
		text-decoration: none;
	}

	.post-meta a:hover {
		color: var(--accent-deep);
		text-decoration: underline;
		text-underline-offset: 0.2rem;
	}

	h3 {
		font-size: clamp(1.25rem, 3vw, 1.65rem);
		letter-spacing: -0.04em;
		line-height: 1.2;
		margin: 0.7rem 0;
	}

	h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	h3 a::after {
		content: ' →';
		color: var(--accent);
		font-size: 0.84em;
	}

	h3 a:active {
		color: var(--accent-deep);
	}

	.summary {
		display: grid;
		gap: 0.35rem;
	}

	.summary p {
		color: var(--ink-muted);
		line-height: 1.7;
		margin: 0;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 1.15rem 0 0;
		padding: 0;
	}

	li a {
		color: var(--accent-deep);
		font-size: 0.8rem;
		letter-spacing: 0.01em;
		text-decoration: none;
	}

	li a:hover {
		text-decoration: underline;
	}

	.post-meta a:active,
	li a:active {
		color: var(--ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card {
			transition: none;
		}
	}
</style>
