---
interface Props {
	writing: 'ai-authored' | 'direct';
	summary: 'ai-generated' | 'direct';
}

const { writing, summary } = Astro.props;
const label =
	writing === 'ai-authored'
		? summary === 'ai-generated'
			? '본문과 요약을 AI가 작성했습니다.'
			: '본문은 AI가 작성했고, 요약은 직접 썼습니다.'
		: summary === 'ai-generated'
			? '본문은 직접 썼고, 요약은 AI가 만들었습니다.'
			: '본문과 요약을 직접 썼습니다.';
---

<p class="provenance"><span aria-hidden="true">✦</span> {label}</p>

<style>
	.provenance {
		color: var(--ink-muted);
		font-size: 0.84rem;
		letter-spacing: 0.01em;
		margin: 0;
	}

	span {
		color: var(--accent);
	}
</style>
