---
import BaseLayout from './BaseLayout.astro';
import { getCategory, type CategorySlug } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import Provenance from '../components/Provenance.astro';
import Comments from '../components/Comments.astro';
import DeskLayout from '../components/DeskLayout.astro';
import NotebookSheet from '../components/NotebookSheet.astro';
import StickyNote from '../components/StickyNote.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	revisions: { date: Date; note: string }[];
	tags: string[];
	category: CategorySlug;
	writing: 'ai-authored' | 'direct';
	summary: 'ai-generated' | 'direct';
	headings: Heading[];
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
	number: number;
}

const { title, description, pubDate, updatedDate, revisions, tags, category, writing, summary, headings, newer, older, number } = Astro.props;
const pageNo = `No.${String(number).padStart(3, '0')}`;
const shortDate = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '.');
const categoryMeta = getCategory(category);
const revisionLog = [...revisions].sort((a, b) => b.date.getTime() - a.date.getTime());
const sourceHistoryUrl = `https://github.com/JosuaLaurant/josualaurant.github.io/commits/main/site/src/content/blog/${Astro.params.slug}.md`;
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'ko',
	keywords: tags,
	mainEntityOfPage: canonicalUrl.href,
	author: { '@type': 'Person', name: 'Josua Laurant', url: new URL('/about/', canonicalUrl).href },
};
---

<BaseLayout title={`${title} | Josua Laurant`} description={description} type="article">
	<Fragment slot="head">
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</Fragment>
	<DeskLayout>
		<NotebookSheet as="article" class="post" pageLabel={pageNo}>
			<header class="post-header">
				<dl class="fields">
					<div><dt>주제</dt><dd><a href={`/categories/${category}/`}>{categoryMeta.label}</a></dd></div>
					<div>
						<dt>날짜</dt>
						<dd class="mono">
							<time datetime={pubDate.toISOString()} title={formatDate(pubDate)}>{shortDate(pubDate)}</time>
							{revisionLog.length > 0 ? (
								<a class="revised" href="#revisions"> (고침 {shortDate(revisionLog[0].date)})</a>
							) : (
								updatedDate && shortDate(updatedDate) !== shortDate(pubDate) && <span> (고침 {shortDate(updatedDate)})</span>
							)}
						</dd>
					</div>
					<div><dt>번호</dt><dd class="mono">{pageNo}</dd></div>
				</dl>
				<h1>{title}</h1>
				<p class="description">{description}</p>
				<Provenance writing={writing} summary={summary} />
				<ul class="tags" aria-label="태그">
					{tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
				</ul>
			</header>
			{tableOfContents.length > 0 && (
				<nav class="toc toc-inline" aria-label="글 목차">
					<strong>목차</strong>
					<ol>
						{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
					</ol>
				</nav>
			)}
			<div class="post-body prose ruled"><slot /></div>
			{revisionLog.length > 0 && (
				<section class="revisions" id="revisions" aria-labelledby="revisions-title">
					<h2 id="revisions-title">고친 기록</h2>
					<ol>
						{revisionLog.map((revision) => (
							<li><time class="mono" datetime={revision.date.toISOString()}>{shortDate(revision.date)}</time><span>{revision.note}</span></li>
						))}
						<li><time class="mono" datetime={pubDate.toISOString()}>{shortDate(pubDate)}</time><span>처음 씀</span></li>
					</ol>
					<a href={sourceHistoryUrl} rel="noopener">원고의 모든 변경 보기 ↗</a>
				</section>
			)}
			<nav class="post-nav" aria-label="다른 글">
				{older && <a class="older" href={`/posts/${older.id}/`}><small>← 이전 장</small><span>{older.data.title}</span></a>}
				{newer && <a class="newer" href={`/posts/${newer.id}/`}><small>다음 장 →</small><span>{newer.data.title}</span></a>}
			</nav>
			<p class="post-list-link"><a href="/posts/">전체 글 목록</a> · <a href={`/categories/${category}/`}>{categoryMeta.label}의 다른 글</a></p>
			<Comments />
		</NotebookSheet>
		{tableOfContents.length > 0 && (
			<div slot="aside" class="toc-aside">
				<StickyNote as="nav" class="toc-note" tilt={1.5} aria-label="글 목차 메모">
					<strong>목차</strong>
					<ol>
						{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
					</ol>
				</StickyNote>
			</div>
		)}
	</DeskLayout>
</BaseLayout>

<script>
	// 코드 블록·이미지·표처럼 높이가 줄 간격의 배수가 아닌 블록 뒤에서 줄이 어긋나지 않게 아래 여백을 보정한다.
	const body = document.querySelector<HTMLElement>('.post-body');
	if (body) {
		const blocks = [...body.querySelectorAll<HTMLElement>(':scope > :is(pre, table, figure, img, blockquote, p:has(> img))')];
		const snap = () => {
			const gap = parseFloat(getComputedStyle(body).lineHeight);
			for (const block of blocks) {
				block.style.marginBottom = '';
				const height = block.getBoundingClientRect().height + parseFloat(getComputedStyle(block).marginBottom);
				block.style.marginBottom = `${parseFloat(getComputedStyle(block).marginBottom) + (Math.ceil(height / gap) * gap - height)}px`;
			}
		};
		snap();
		new ResizeObserver(snap).observe(body);
	}
</script>

<style>
	.fields {
		border: 1.5px solid var(--accent-deep);
		border-radius: 3px;
		display: grid;
		grid-template-columns: 1fr 1.25fr 0.8fr;
		margin: 0 0 var(--rule-gap);
	}

	.fields div {
		border-left: 1px solid var(--accent-deep);
		min-width: 0;
		padding: 0.3rem 0.7rem 0.45rem;
	}

	.fields div:first-child {
		border-left: 0;
	}

	dt {
		color: var(--accent-deep);
		font-size: 0.66rem;
		font-weight: 700;
	}

	dd {
		color: var(--ink);
		font-size: 0.86rem;
		margin: 0;
	}

	dd a {
		color: inherit;
		text-decoration: none;
	}

	dd a:hover {
		color: var(--accent-deep);
		text-decoration: underline;
		text-underline-offset: 0.2rem;
	}

	dd span {
		color: var(--ink-muted);
		font-size: 0.78rem;
	}

	dd .revised {
		color: var(--pen-red);
		font-size: 0.78rem;
	}

	h1 {
		font-size: clamp(1.8rem, 4.5vw, 2.6rem);
		letter-spacing: -0.05em;
		line-height: 3rem;
		margin: 0 0 1rem;
	}

	.description {
		color: var(--ink-muted);
		font-size: clamp(1rem, 2vw, 1.12rem);
		line-height: var(--rule-gap);
		margin: 0;
	}

	.post-header :global(.provenance) {
		line-height: var(--rule-gap);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		list-style: none;
		margin: 0 0 var(--rule-gap);
		padding: 0;
	}

	.tags a {
		align-items: center;
		color: var(--accent-deep);
		display: inline-flex;
		font-size: 0.84rem;
		min-height: var(--rule-gap);
		text-decoration: none;
	}

	.tags a:hover {
		text-decoration: underline;
	}

	.toc-inline {
		border: 1px dashed var(--line-strong);
		border-radius: 4px;
		font-size: 0.92rem;
		margin: 0 0 var(--rule-gap);
		padding: 0.8rem 1rem;
	}

	.toc-inline ol,
	.toc-aside ol {
		margin: 0.4rem 0 0;
		padding-left: 1.2rem;
	}

	.toc-inline li + li {
		margin-top: 0.3rem;
	}

	.toc-inline a {
		color: var(--ink);
	}

	.toc-aside {
		display: none;
	}

	.toc-aside :global(.toc-note) {
		width: 13.5rem;
	}

	.toc-aside strong {
		display: block;
		font-size: 1rem;
	}

	.toc-aside ol {
		font-size: 0.86rem;
		line-height: 1.7;
	}

	@media (min-width: 78rem) {
		.toc-inline {
			display: none;
		}

		.toc-aside {
			display: block;
			height: 100%;
		}

		.toc-aside :global(.toc-note) {
			position: sticky;
			top: 2rem;
		}
	}

	/* 공개 뒤 고친 내용을 빨간 펜으로 덧적은 메모처럼 보여 준다. */
	.revisions {
		border-top: 1.5px dashed var(--pen-red);
		margin-top: var(--rule-gap);
		padding-top: 1rem;
	}

	.revisions h2 {
		color: var(--pen-red);
		font-size: 0.9rem;
		letter-spacing: 0;
		line-height: var(--rule-gap);
		margin: 0;
	}

	.revisions ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.revisions li {
		display: grid;
		font-size: 0.9rem;
		gap: 0 1rem;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		line-height: 1.6;
		padding: 0.3rem 0;
	}

	.revisions time {
		color: var(--pen-red);
		font-size: 0.82rem;
	}

	.revisions li:last-child span {
		color: var(--ink-muted);
	}

	.revisions > a {
		color: var(--ink-muted);
		display: inline-block;
		font-size: 0.82rem;
		margin-top: 0.4rem;
		text-underline-offset: 0.2rem;
	}

	.revisions > a:hover {
		color: var(--accent-deep);
	}

	.post-nav {
		display: grid;
		gap: 0.9rem;
		margin-top: var(--rule-gap);
	}

	.post-nav a {
		border: 1px solid var(--line-strong);
		border-radius: 4px;
		color: var(--ink);
		display: grid;
		gap: 0.2rem;
		padding: 0.8rem 1rem;
		text-decoration: none;
	}

	.post-nav a:hover {
		border-color: var(--accent);
	}

	.post-nav a:active {
		background: var(--accent-soft);
		border-color: var(--accent-deep);
	}

	@media (min-width: 40rem) {
		.post-nav {
			grid-template-columns: 1fr 1fr;
		}

		.post-nav .newer {
			grid-column: 2;
			text-align: right;
		}
	}

	.post-nav small {
		color: var(--pen-red);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.post-nav span {
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.4;
	}

	.post-list-link {
		color: var(--ink-muted);
		font-size: 0.9rem;
		margin: 1rem 0 0;
	}

	.post-list-link a {
		color: var(--accent-deep);
		text-underline-offset: 0.2rem;
	}

	@media (max-width: 30rem) {
		.fields {
			grid-template-columns: 1fr 1fr;
		}

		.revisions li {
			grid-template-columns: minmax(0, 1fr);
		}

		.fields div:last-child {
			border-left: 0;
			border-top: 1px solid var(--accent-deep);
			grid-column: 1 / 3;
		}
	}
</style>
