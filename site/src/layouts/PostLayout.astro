---
import BaseLayout from './BaseLayout.astro';
import { getCategory, type CategorySlug } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import Provenance from '../components/Provenance.astro';
import Comments from '../components/Comments.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags: string[];
	category: CategorySlug;
	writing: 'ai-authored' | 'direct';
	summary: 'ai-generated' | 'direct';
	headings: Heading[];
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
}

const { title, description, pubDate, updatedDate, tags, category, writing, summary, headings, newer, older } = Astro.props;
const categoryMeta = getCategory(category);
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'ko',
	keywords: tags,
	mainEntityOfPage: canonicalUrl.href,
	author: { '@type': 'Person', name: 'Josua Laurant', url: new URL('/about/', canonicalUrl).href },
};
---

<BaseLayout title={`${title} | Josua Laurant`} description={description} type="article">
	<Fragment slot="head">
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</Fragment>
	<article class="post">
		<header class="post-header">
			<p class="eyebrow"><a href={`/categories/${category}/`}>{categoryMeta.label}</a></p>
			<h1>{title}</h1>
			<p class="description">{description}</p>
			<Provenance writing={writing} summary={summary} />
			<p class="date">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				{updatedDate && <span> · 업데이트 {formatDate(updatedDate)}</span>}
			</p>
			<ul class="tags" aria-label="태그">
				{tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
			</ul>
		</header>
		{tableOfContents.length > 0 && (
			<nav class="toc" aria-label="글 목차">
				<strong>목차</strong>
				<ol>
					{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
				</ol>
			</nav>
		)}
		<div class="post-body prose"><slot /></div>
		<nav class="post-nav" aria-label="다른 글">
			{older && <a class="older" href={`/posts/${older.id}/`}><small>이전 글</small><span>{older.data.title}</span></a>}
			{newer && <a class="newer" href={`/posts/${newer.id}/`}><small>다음 글</small><span>{newer.data.title}</span></a>}
		</nav>
		<p class="post-list-link"><a href="/posts/">전체 글 목록</a> · <a href={`/categories/${category}/`}>{categoryMeta.label}의 다른 글</a></p>
		<Comments />
	</article>
</BaseLayout>

<style>
	.post {
		margin-inline: auto;
		max-width: var(--article-max);
		padding-top: clamp(3.5rem, 9vw, 7rem);
	}

	.post-header h1 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		letter-spacing: -0.055em;
		line-height: 1.12;
		margin: 0.75rem 0 1rem;
	}

	.description {
		color: var(--ink-muted);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		line-height: 1.75;
		margin: 0 0 0.6rem;
	}

	.date {
		color: var(--ink-muted);
		font-size: 0.9rem;
		margin: 1.3rem 0 0;
	}

	.eyebrow a {
		color: inherit;
		text-decoration: none;
	}

	.eyebrow a:hover {
		color: var(--accent-deep);
		text-decoration: underline;
		text-underline-offset: 0.22rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		list-style: none;
		margin: 0.7rem 0 0;
		padding: 0;
	}

	.tags a {
		align-items: center;
		color: var(--accent-deep);
		display: inline-flex;
		font-size: 0.84rem;
		min-height: 1.75rem;
		text-decoration: none;
	}

	.tags a:hover {
		text-decoration: underline;
	}

	.toc {
		background: var(--accent-soft);
		border-radius: var(--radius-panel);
		font-size: 0.92rem;
		margin: 3rem 0;
		padding: 1.2rem 1.3rem;
	}

	.toc ol {
		margin: 0.65rem 0 0;
		padding-left: 1.25rem;
	}

	.toc li + li {
		margin-top: 0.35rem;
	}

	.toc a {
		color: var(--ink);
	}

	.post-body {
		padding-bottom: 1rem;
	}

	.post-nav {
		border-top: 1px solid var(--line);
		display: grid;
		gap: 0.9rem;
		margin-top: clamp(2.5rem, 6vw, 3.5rem);
		padding-top: clamp(1.5rem, 4vw, 2rem);
	}

	.post-nav a {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		color: var(--ink);
		display: grid;
		gap: 0.3rem;
		padding: 1rem 1.15rem;
		text-decoration: none;
	}

	.post-nav a:hover {
		border-color: var(--accent);
	}

	.post-nav a:active {
		background: var(--accent-soft);
		border-color: var(--accent-deep);
	}

	@media (min-width: 40rem) {
		.post-nav {
			grid-template-columns: 1fr 1fr;
		}

		.post-nav .newer {
			grid-column: 2;
			text-align: right;
		}
	}

	.post-nav small {
		color: var(--ink-muted);
		font-size: 0.8rem;
	}

	.post-nav span {
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.4;
	}

	.post-list-link {
		color: var(--ink-muted);
		font-size: 0.9rem;
		margin: 1rem 0 0;
	}

	.post-list-link a {
		color: var(--accent-deep);
		text-underline-offset: 0.2rem;
	}
</style>
