---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeskLayout from '../components/DeskLayout.astro';
import NotebookSheet from '../components/NotebookSheet.astro';
---

<BaseLayout title="찾을 수 없는 페이지 | Josua Laurant" description="요청한 페이지가 없습니다.">
	<DeskLayout>
		<NotebookSheet class="not-found" pageLabel="404">
			<p class="eyebrow mono">404</p>
			<h1>여기에는 아직<br />기록이 없습니다.</h1>
			<div class="ruled">
				<p>주소가 바뀌었거나 아직 공개되지 않은 글일 수 있습니다.</p>
				<a href="/">목차로 돌아가기</a>
			</div>
		</NotebookSheet>
	</DeskLayout>
</BaseLayout>

<style>
	.eyebrow {
		line-height: var(--rule-gap);
	}

	h1 {
		font-size: clamp(1.9rem, 5vw, 3rem);
		letter-spacing: -0.05em;
		line-height: 3.5rem;
		margin: 0 0 var(--rule-gap);
	}

	.ruled {
		line-height: var(--rule-gap);
		padding-bottom: var(--rule-gap);
	}

	p {
		color: var(--ink-muted);
		margin: 0;
	}

	a {
		color: var(--accent-deep);
		font-weight: 700;
		text-underline-offset: 0.24rem;
	}
</style>
