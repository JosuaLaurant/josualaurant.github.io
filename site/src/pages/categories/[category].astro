---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCategory, getPublishedCategories, type CategorySlug } from '../../lib/categories';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return getPublishedCategories(posts).map((category) => ({
		params: { category: category.slug },
		props: { category: category.slug, posts: category.posts },
	}));
}

interface Props {
	category: CategorySlug;
	posts: CollectionEntry<'blog'>[];
}

const { category, posts } = Astro.props as Props;
const categoryMeta = getCategory(category);
---

<BaseLayout title={`${categoryMeta.label} | Josua Laurant`} description={categoryMeta.description}>
	<section class="category-page" aria-labelledby="category-title">
		<p class="eyebrow">TOPIC</p>
		<h1 id="category-title">{categoryMeta.label}</h1>
		<p class="description">{categoryMeta.description}</p>
		<p class="count">{posts.length}개의 글</p>
		<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
	</section>
</BaseLayout>

<style>
	.category-page {
		margin-inline: auto;
		max-width: 55rem;
		padding-top: clamp(3.5rem, 9vw, 7rem);
	}

	h1 {
		font-size: clamp(2.5rem, 7vw, 4.8rem);
		letter-spacing: -0.065em;
		margin: 0.6rem 0;
	}

	.description,
	.count {
		color: var(--ink-muted);
		margin: 0;
	}

	.description {
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.count {
		font-size: 0.9rem;
		margin-top: 1rem;
	}

	.post-list {
		display: grid;
		gap: 0.9rem;
		margin-top: 2.5rem;
	}
</style>
