---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotebookSheet from '../../components/NotebookSheet.astro';
import StickyNote from '../../components/StickyNote.astro';
import { getPublishedCategories } from '../../lib/categories';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const categories = getPublishedCategories(posts);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
const colors = ['yellow', 'pink', 'mint', 'blue'] as const;
const tilts = [-2.5, 2, -1.5, 2.5];
---

<BaseLayout title="주제 | Josua Laurant" description="글을 주제와 태그로 찾아봅니다.">
	<div class="board">
		<NotebookSheet aria-labelledby="topics-title">
			<h1 id="topics-title">주제</h1>
			<p class="lede">각 글은 주제 하나에 속하고, 태그로 더 좁혀 찾을 수 있습니다.</p>
			<ul class="notes">
				{categories.map((category, index) => (
					<li>
						<StickyNote href={`/categories/${category.slug}/`} color={colors[index % colors.length]} tilt={tilts[index % tilts.length]}>
							<strong>{category.label}</strong>
							<span>{category.description}</span>
							<small>{category.posts.length}개의 글 →</small>
						</StickyNote>
					</li>
				))}
			</ul>
			<h2>태그</h2>
			<ul class="tag-list">
				{tags.map((tag) => (
					<li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
				))}
			</ul>
		</NotebookSheet>
	</div>
</BaseLayout>

<style>
	.board {
		padding-top: clamp(2rem, 5vw, 3.2rem);
	}

	h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		letter-spacing: -0.05em;
		line-height: 4rem;
		margin: 0;
	}

	.lede {
		color: var(--ink-muted);
		line-height: var(--rule-gap);
		margin: 0;
	}

	.notes {
		display: flex;
		flex-wrap: wrap;
		gap: 1.8rem 1.4rem;
		list-style: none;
		margin: 2.6rem 0 0;
		padding: 0;
	}

	.notes li {
		display: contents;
	}

	strong {
		display: block;
		font-size: 1.05rem;
		letter-spacing: -0.03em;
		margin-bottom: 0.35rem;
	}

	span {
		display: block;
		font-size: 0.82rem;
		line-height: 1.55;
		opacity: 0.82;
	}

	small {
		display: block;
		font-size: 0.75rem;
		font-weight: 700;
		margin-top: 0.6rem;
		opacity: 0.75;
	}

	h2 {
		color: var(--accent-deep);
		font-size: 0.95rem;
		line-height: var(--rule-gap);
		margin: 3rem 0 0.8rem;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tag-list a {
		align-items: center;
		background: repeating-linear-gradient(-45deg, var(--accent-soft) 0 6px, transparent 6px 12px), var(--paper);
		border: 1px solid var(--line-strong);
		border-radius: 2px;
		color: var(--ink);
		display: inline-flex;
		min-height: 2.25rem;
		padding: 0 0.85rem;
		text-decoration: none;
	}

	.tag-list a:hover {
		border-color: var(--accent);
	}

	.tag-list a:active {
		border-color: var(--accent-deep);
		color: var(--accent-deep);
	}
</style>
