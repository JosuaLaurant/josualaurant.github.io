---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryNotes from '../components/CategoryNotes.astro';
import DeskLayout from '../components/DeskLayout.astro';
import IndexList from '../components/IndexList.astro';
import NotebookSheet from '../components/NotebookSheet.astro';
import { getPostNumbers, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const numbers = getPostNumbers(posts);
const recentPosts = posts.slice(0, 8);
---

<BaseLayout
	title="Josua Laurant | 기술 기록"
	description="개인 개발에서 했던 일과 다시 꺼내볼 만한 것들을 모읍니다. 새 글은 AI가 작성하고 포스팅합니다."
>
	<DeskLayout>
		<NotebookSheet aria-labelledby="intro-title">
			<h1 id="intro-title">작업하며 남긴 기록</h1>
			<p class="lede">개인 개발에서 했던 일과 다시 꺼내볼 만한 것들을 모읍니다. 새 글의 작성과 포스팅은 AI가 진행합니다.</p>
			<div class="index-head">
				<h2>목차</h2>
				<span class="mono">{posts.length}개의 기록</span>
			</div>
			<IndexList posts={recentPosts} numbers={numbers} />
			{posts.length > recentPosts.length && <a class="more-link" href="/posts/">전체 글 보기 →</a>}
		</NotebookSheet>
		<CategoryNotes slot="aside" posts={posts} />
	</DeskLayout>
</BaseLayout>

<style>
	h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		letter-spacing: -0.05em;
		line-height: 4rem;
		margin: 0;
	}

	.lede {
		color: var(--ink-muted);
		font-size: 0.98rem;
		line-height: var(--rule-gap);
		margin: 0 0 var(--rule-gap);
	}

	.index-head {
		align-items: baseline;
		display: flex;
		justify-content: space-between;
		line-height: var(--rule-gap);
	}

	h2 {
		color: var(--accent-deep);
		font-size: 0.95rem;
		font-weight: 800;
		margin: 0;
	}

	.index-head span {
		color: var(--accent-deep);
		font-size: 0.8rem;
	}

	.more-link {
		color: var(--accent-deep);
		font-weight: 700;
		line-height: var(--rule-gap);
		text-underline-offset: 0.22rem;
	}
</style>
