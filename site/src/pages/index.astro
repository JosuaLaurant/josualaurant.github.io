---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedCategories } from '../lib/categories';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const categories = getPublishedCategories(posts);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
---

<BaseLayout
	title="Josua Laurant | 기술 기록"
	description="개인 개발에서 했던 일과 다시 꺼내볼 만한 것들을 모읍니다. 새 글은 AI가 작성하고 포스팅합니다."
>
	<section class="hero" aria-labelledby="intro-title">
		<h1 id="intro-title">작업하며 남긴 기록</h1>
		<p class="lede">
			개인 개발에서 했던 일과 다시 꺼내볼 만한 것들을 모읍니다. 새 글의 작성과 포스팅은 AI가
			진행합니다.
		</p>
		<a class="primary-link" href="#posts">최근 글 보기 <span aria-hidden="true">↓</span></a>
	</section>

	<section id="posts" class="section" aria-labelledby="posts-title">
		<div class="section-heading">
			<h2 id="posts-title">최근 글</h2>
			<p>{posts.length}개의 공개 기록</p>
		</div>
		<div class="post-list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	<section id="categories" class="section" aria-labelledby="categories-title">
		<div class="section-heading">
			<h2 id="categories-title">주제별로 보기</h2>
			<p>글의 성격에 따라 나눕니다.</p>
		</div>
		<ul class="category-list">
			{categories.map((category) => (
				<li>
					<a href={`/categories/${category.slug}/`}>
						<strong>{category.label}</strong>
						<span>{category.description}</span>
						<small>{category.posts.length}개의 글</small>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="topics section" aria-labelledby="topics-title">
		<h2 id="topics-title">태그로 찾기</h2>
		<ul>
			{tags.map((tag) => (
				<li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: clamp(4.5rem, 13vw, 9rem) 0 clamp(4rem, 10vw, 7.5rem);
		max-width: 51rem;
	}

	.hero h1 {
		margin: 0.75rem 0 1.5rem;
		font-size: clamp(2.8rem, 8vw, 5.7rem);
		letter-spacing: -0.065em;
		line-height: 0.98;
	}

	.lede {
		color: var(--ink-muted);
		font-size: clamp(1.05rem, 2vw, 1.28rem);
		line-height: 1.8;
		max-width: 40rem;
	}

	.primary-link {
		display: inline-flex;
		gap: 0.6rem;
		align-items: center;
		margin-top: 1.2rem;
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 0.28rem;
	}

	.primary-link:active {
		border-color: var(--accent-deep);
		color: var(--accent-deep);
	}

	.section {
		padding: clamp(2.8rem, 7vw, 5rem) 0;
		border-top: 1px solid var(--line);
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		gap: 1.25rem;
		align-items: end;
		margin-bottom: 1.25rem;
	}

	.section-heading > p {
		color: var(--ink-muted);
		font-size: 0.9rem;
		margin: 0;
	}

	.section h2 {
		font-size: clamp(1.8rem, 4vw, 2.7rem);
		letter-spacing: -0.045em;
		margin: 0.4rem 0 0;
	}

	.post-list {
		display: grid;
		gap: 0.9rem;
	}

	.category-list {
		display: grid;
		gap: 0.9rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.category-list a {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		color: var(--ink);
		display: grid;
		gap: 0.55rem;
		min-height: 11rem;
		padding: clamp(1.2rem, 3vw, 1.6rem);
		text-decoration: none;
	}

	.category-list a:hover {
		border-color: var(--accent);
	}

	.category-list a:active {
		background: var(--accent-soft);
		border-color: var(--accent-deep);
	}

	.category-list strong {
		font-size: 1.15rem;
		letter-spacing: -0.035em;
	}

	.category-list span,
	.category-list small {
		color: var(--ink-muted);
		line-height: 1.65;
	}

	.category-list small {
		align-self: end;
		font-size: 0.8rem;
	}

	.topics ul {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
	}

	.topics a {
		display: block;
		border: 1px solid var(--line-strong);
		border-radius: 99rem;
		color: var(--ink);
		padding: 0.42rem 0.72rem;
		text-decoration: none;
	}

	.topics a:hover {
		background: var(--accent-soft);
	}

	.topics a:active {
		border-color: var(--accent-deep);
		color: var(--accent-deep);
	}

	@media (max-width: 34rem) {
		.section-heading {
			align-items: start;
			flex-direction: column;
		}
	}
</style>
