---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNotes from '../../components/CategoryNotes.astro';
import DeskLayout from '../../components/DeskLayout.astro';
import IndexList from '../../components/IndexList.astro';
import NotebookSheet from '../../components/NotebookSheet.astro';
import { getPostNumbers, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const numbers = getPostNumbers(posts);
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];
---

<BaseLayout title="전체 글 | Josua Laurant" description="이 블로그에 공개한 모든 기술 기록입니다.">
	<DeskLayout>
		<NotebookSheet aria-labelledby="archive-title">
			<h1 id="archive-title">전체 글</h1>
			<p class="count mono">{posts.length}개의 공개 기록</p>
			{years.map((year) => (
				<section aria-labelledby={`year-${year}`}>
					<h2 id={`year-${year}`} class="mono">{year}</h2>
					<IndexList posts={posts.filter((post) => post.data.pubDate.getFullYear() === year)} numbers={numbers} />
				</section>
			))}
		</NotebookSheet>
		<CategoryNotes slot="aside" posts={posts} />
	</DeskLayout>
</BaseLayout>

<style>
	h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		letter-spacing: -0.05em;
		line-height: 4rem;
		margin: 0;
	}

	.count {
		color: var(--ink-muted);
		font-size: 0.85rem;
		line-height: var(--rule-gap);
		margin: 0 0 var(--rule-gap);
	}

	h2 {
		color: var(--accent-deep);
		font-size: 0.95rem;
		line-height: var(--rule-gap);
		margin: 0;
	}
</style>
