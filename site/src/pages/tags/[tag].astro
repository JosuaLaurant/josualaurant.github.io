---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNotes from '../../components/CategoryNotes.astro';
import DeskLayout from '../../components/DeskLayout.astro';
import IndexList from '../../components/IndexList.astro';
import NotebookSheet from '../../components/NotebookSheet.astro';
import { getPostNumbers, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const postsByTag = new Map<string, typeof posts>();

	for (const post of posts) {
		for (const tag of post.data.tags) {
			postsByTag.set(tag, [...(postsByTag.get(tag) ?? []), post]);
		}
	}

	return [...postsByTag].map(([tag, taggedPosts]) => ({
		params: { tag },
		props: { tag, posts: taggedPosts, allPosts: posts },
	}));
}

const { tag, posts, allPosts } = Astro.props;
const numbers = getPostNumbers(allPosts);
---

<BaseLayout title={`#${tag} | Josua Laurant`} description={`${tag} 태그의 기술 기록입니다.`}>
	<DeskLayout>
		<NotebookSheet aria-labelledby="tag-title">
			<p class="eyebrow">태그</p>
			<h1 id="tag-title">#{tag}</h1>
			<p class="count mono">{posts.length}개의 글</p>
			<IndexList posts={posts} numbers={numbers} />
		</NotebookSheet>
		<CategoryNotes slot="aside" posts={allPosts} />
	</DeskLayout>
</BaseLayout>

<style>
	.eyebrow {
		line-height: var(--rule-gap);
	}

	h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		letter-spacing: -0.05em;
		line-height: 4rem;
		margin: 0;
	}

	.count {
		color: var(--ink-muted);
		font-size: 0.85rem;
		line-height: var(--rule-gap);
		margin: 0 0 var(--rule-gap);
	}
</style>
