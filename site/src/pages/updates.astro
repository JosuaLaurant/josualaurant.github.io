---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DeskLayout from '../components/DeskLayout.astro';
import NotebookSheet from '../components/NotebookSheet.astro';
import { formatDate } from '../lib/posts';

const updates = (await getCollection('updates'))
	.filter((update) => !update.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.data.version.localeCompare(a.data.version));
---

<BaseLayout title="업데이트 | Josua Laurant" description="이 블로그의 공개 변경 기록입니다.">
	<DeskLayout>
		<NotebookSheet aria-labelledby="updates-title">
			<p class="eyebrow">변경 기록</p>
			<h1 id="updates-title">업데이트</h1>
			<p class="lede">이 블로그 자체에 적용한 변경을 버전별로 남깁니다.</p>
			<ol class="update-list ruled">
				{updates.map((update) => (
					<li>
						<article>
							<header>
								<p class="version mono">{update.data.version}</p>
								<time class="mono" datetime={update.data.pubDate.toISOString()}>{formatDate(update.data.pubDate)}</time>
							</header>
							<h2>{update.data.title}</h2>
							<ul>
								{update.data.changes.map((change) => <li>{change}</li>)}
							</ul>
						</article>
					</li>
				))}
			</ol>
		</NotebookSheet>
	</DeskLayout>
</BaseLayout>

<style>
	.eyebrow {
		line-height: var(--rule-gap);
	}

	h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		letter-spacing: -0.05em;
		line-height: 4rem;
		margin: 0;
	}

	.lede {
		color: var(--ink-muted);
		line-height: var(--rule-gap);
		margin: 0 0 var(--rule-gap);
	}

	.update-list {
		line-height: var(--rule-gap);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.update-list > li {
		padding-bottom: var(--rule-gap);
	}

	article header {
		align-items: baseline;
		display: flex;
		gap: 0.75rem;
		justify-content: space-between;
	}

	.version {
		color: var(--pen-red);
		font-size: 0.85rem;
		font-weight: 700;
		margin: 0;
	}

	time {
		color: var(--ink-muted);
		font-size: 0.8rem;
	}

	h2 {
		font-size: 1.15rem;
		letter-spacing: -0.03em;
		line-height: var(--rule-gap);
		margin: 0;
	}

	ul {
		color: var(--ink-muted);
		margin: 0;
		padding-left: 1.25rem;
	}
</style>
